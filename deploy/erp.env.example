# Copy this file to /opt/erp/erp.env on the VPS and fill in real values.
# chmod 600 /opt/erp/erp.env   (only the erp user should be able to read secrets)
# NEVER commit the real erp.env file to git.

DB_URL=jdbc:mysql://127.0.0.1:3306/erp_prod?useSSL=true&serverTimezone=Asia/Kolkata&allowPublicKeyRetrieval=true
DB_USERNAME=erp_user
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Use 'update' only for the very first deploy so Hibernate creates the schema,
# then switch to 'validate' for all subsequent deploys.
DDL_AUTO=update

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=billing@yourdomain.com
MAIL_PASSWORD=CHANGE_ME_APP_PASSWORD
MAIL_FROM=billing@yourdomain.com

APP_BASE_URL=https://yourdomain.com
